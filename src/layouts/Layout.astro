---
// src/layouts/Layout.astro
import '../styles/global.scss';
import GoogleFont from '../components/core/GoogleFont.astro';
import Seo from '../components/core/Seo.astro';

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    canonical?: string;
    schema?: string; // Permet de remonter le schéma de index.astro vers Seo.astro
}

const {
    title,
    description = 'Portfolio personnel de Llehuni — projets, parcours et compétences techniques.',
    ogImage,
    canonical,
    schema
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || 'https://llehuni.dev').href;
const ogImageURL = ogImage || new URL('/_astro/llehuni-picture.jpg', Astro.site || 'https://llehuni.dev').href;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />

        <Seo 
            title={title}
            description={description}
            canonicalUrl={canonicalURL}
            ogImageURL={ogImageURL}
            schema={schema}
        />

        <GoogleFont family="Figtree" weights="300..900" />
    </head>
    <body>
        <slot />
    </body>
</html>